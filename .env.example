# Every variable without a default is required: `app/config.py` refuses to build its
# settings without it, so the process stops at startup instead of running on a wrong
# value. They must be in the real process environment (compose's `env_file` puts them
# there) — a .env file is deliberately not read here, since the engine reads os.environ
# directly and would never see one.

# --- secrets (no defaults) ---
JWT_SECRET=generate-at-least-32-random-characters
OPENAI_API_KEY=
ADMIN_USERNAME=admin              # the first super admin, made by the seed script
ADMIN_PASSWORD=change-me-please   # at least 8 characters

# --- database: either DATABASE_URL, or the parts it is assembled from ---
# Plain `postgresql://`, not SQLAlchemy's old `postgresql+psycopg2://` — Prisma parses
# the URL itself and refuses a scheme it does not know.
# DATABASE_URL=postgresql://jobqa:secret@db:5432/jobqa
POSTGRES_USER=jobqa
POSTGRES_PASSWORD=secret
POSTGRES_DB=jobqa
DATABASE_HOST=db
DATABASE_PORT=5432

# --- the RAG engine (job_qa_service/config.py reads these on its own) ---
OPENAI_BASE_URL=https://api.gapgpt.app/v1
LLM_MODEL=gpt-4o-mini
EMBED_MODEL_NAME=BAAI/bge-m3
EMB_CACHE_DIR=/srv/emb_cache      # a mounted volume in deployment; `emb_cache` locally

# --- rate limiting (src/rate_limit.py); the values shown are the defaults ---
# RATE_LIMIT_ENABLED=true
# LOGIN_RATE_LIMIT=10             # wrong passwords per account per source, per window
# LOGIN_RATE_WINDOW=300
# SEARCH_RATE_LIMIT=20            # searches per account per window
# SEARCH_RATE_WINDOW=60
# TRUST_FORWARDED_FOR=false       # on only behind a proxy that rewrites the header
